<?php

declare(strict_types=1);

/** Restrict the club skin to the V2 workspace and native account screens. */
function tcl_bureau_is_workspace(): bool {
  $route = (string) \Drupal::routeMatch()->getRouteName();
  return str_starts_with($route, 'tcl_bureau.') || in_array($route, ['tcl_identity.login', 'user.login', 'user.pass', 'user.reset.form', 'entity.user.edit_form', 'user.logout', 'user.logout.confirm'], TRUE);
}

/** Account presentation only; native permissions, tokens and handlers stay intact. */
function tcl_bureau_is_account_page(): bool {
  return in_array(\Drupal::routeMatch()->getRouteName(), ['tcl_identity.login', 'user.login', 'user.pass', 'user.reset.form', 'entity.user.edit_form'], TRUE);
}

/** Implements hook_preprocess_html(). */
function tcl_bureau_preprocess_html(array &$variables): void {
  if (tcl_bureau_is_account_page()) {
    $variables['attributes']['class'][] = 'tcl-account-page';
  }
}

/** Implements hook_form_FORM_ID_alter(). */
function tcl_bureau_form_user_pass_reset_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $form['actions']['submit']['#value'] = t('Choisir mon mot de passe');
}

/** Implements hook_page_attachments(). */
function tcl_bureau_page_attachments(array &$attachments): void {
  $attachments['#cache']['contexts'][] = 'route';
  if (tcl_bureau_is_account_page()) {
    $attachments['#attached']['library'][] = 'tcl_bureau/account';
  }
  if (tcl_bureau_is_workspace()) {
    $attachments['#attached']['library'][] = 'tcl_bureau/bureau';
  }
}

/** Implements hook_page_top(): never present the local provider as live OAuth. */
function tcl_bureau_page_top(array &$page_top): void {
  $settings = \Drupal\Core\Site\Settings::get('tcl_bureau_oauth', []);
  if (($settings['local_fixture'] ?? FALSE) === TRUE && str_starts_with(\Drupal::request()->getPathInfo(), '/bureau')) {
    $page_top['oauth_fixture_notice'] = ['#type' => 'html_tag', '#tag' => 'p', '#value' => 'Recette locale : connexion OAuth simulée et données fictives uniquement.', '#attributes' => ['role' => 'status', 'style' => 'padding:1rem;margin:0;background:#fff1b8;color:#332700;font:600 1rem system-ui']];
  }
  elseif (($settings['local_provider'] ?? FALSE) === TRUE && (str_starts_with(\Drupal::request()->getPathInfo(), '/bureau') || in_array(\Drupal::routeMatch()->getRouteName(), ['user.login', 'tcl_identity.login'], TRUE))) {
    $page_top['oauth_local_notice'] = ['#type' => 'html_tag', '#tag' => 'p', '#value' => 'Recette locale : OAuth TC Longages, comptes et données de test uniquement.', '#attributes' => ['role' => 'status', 'style' => 'padding:1rem;margin:0;background:#fff1b8;color:#332700;font:600 1rem system-ui']];
  }
}

/** Vary the branding block by route before its render cache is consulted. */
function tcl_bureau_block_build_alter(array &$build, \Drupal\Core\Block\BlockPluginInterface $block): void {
  if ($block->getPluginId() === 'system_branding_block') {
    $build['#cache']['contexts'][] = 'route';
  }
}

/** Reuse the supplied club logo before or after core's branding preprocess. */
function tcl_bureau_preprocess_block(array &$variables): void {
  if (($variables['base_plugin_id'] ?? '') === 'system_branding_block' && tcl_bureau_is_workspace()) {
    $logo = base_path() . 'modules/custom/tcl_bureau/images/logo.jpeg';
    $variables['content']['site_logo']['#uri'] = $logo;
    $variables['site_logo'] = $logo;
  }
}

/** Implements hook_mail(). */
function tcl_bureau_mail($key, &$message, $params): void {
  if (in_array($key, ['account_invitation', 'registration', 'member_communication'], TRUE)) {
    $message['subject'] = $params['subject'];
    $message['body'][] = $params['body'];
  }
}
