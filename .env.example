# Exemple inactif : compléter seulement après choix du fournisseur et de l'adresse.
TCL_PUBLIC_BASE_URL=https://bureau.VOTRE-DOMAINE.invalid
TCL_OIDC_ISSUER=https://FOURNISSEUR-A-CONFIRMER.invalid
TCL_OIDC_CLIENT_ID=
TCL_OIDC_CLIENT_SECRET=
# Fichier privé, hors du dossier servi par Apache.
TCL_OIDC_ACCOUNTS_FILE=.local/oidc-accounts.json
# HTTP autorisé uniquement sur localhost/127.0.0.1 et en recette explicite.
TCL_OIDC_LOCAL_HTTP=false
# Activer seulement après vérification du proxy local TLS o2switch (jamais un proxy arbitraire).
TCL_OIDC_TRUST_LOCAL_PROXY=false
PORT=4175
